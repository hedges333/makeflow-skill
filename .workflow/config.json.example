{
  "$comment": "Makefile Workflow User Configuration Template. Cascades default -> legacy ~/.gemini/config/makeflow.json -> agent plugin_data/makeflow/config.json -> .workflow/config.json -> env. Subagent tiers are specific to Google Antigravity (agy). Valid tiers are inherit, flash_lite, flash, and pro. When set to inherit, subagents inherit the active model and session reasoning effort (/effort). Other platforms ignore this section.",
  "models": {
    "adversarial-critic": "inherit",
    "archaeology-worker": "inherit",
    "tdd-worker": "inherit",
    "triage-worker": "inherit",
    "synthetic-scar-importer": "inherit"
  },
  "review": {
    "maxReviewRounds": 3,
    "strictSixPillars": true,
    "allowCriticHermeticTests": false
  },
  "testing": {
    "regressionCommand": "",
    "regressionTimeoutSeconds": 300
  },
  "ci": {
    "pollIntervalSeconds": 30,
    "quiescenceSeconds": 180,
    "enablePeerReviews": false,
    "minApprovals": 0,
    "requireCodeOwnerReviews": false,
    "enableSessionParking": false,
    "parkingCronExpression": ""
  },
  "database": {
    "prodDatabases": [],
    "testDatabases": [],
    "prodHosts": []
  },
  "state": {
    "completedCardAction": "unlink"
  },
  "scars": {
    "databases": [
      ".workflow/scars/scars_registry.db",
      "{agent_data}/scars_registry.db",
      "{plugin_root}/skills/makeflow/data/scars_registry.db"
    ]
  }
}
